{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {"analytics": false},
  "projects": {
    "repro": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": "dist/repro",
            "optimization": false,
            "sourceMap": true
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"buildTarget": "repro:build"}
        }
      }
    }
  }
}
